{
  // from here, you can be able to adjust the order of
  // each core modules (compact + detailed)
  // Everything is under your control!!
  // BinaryFetch supports utf8 format
  // means, you can use emoji everywhere 
  // (unless you terminal doesn't support it)


  // we can also toggle whole section by just commenting them form the order. (make sure to put the comma properly)
  "section_order": [
  "header_settings",
  "compact_date_and_time",
  "compact_operating_system",
  "compact_processor",
  "compact_graphics_card",
  "compact_display_monitor",
  "compact_system_memory",
  "compact_audio_devices",
  "compact_resource_usage",
  "compact_user_account",
  "compact_network_connection",
  "compact_disk_storage",
  "detailed_resource_usage",
  //"detailed_system_memory",
  "detailed_disk_storage"
  //"detailed_operating_system",
  //"detailed_processor",
  //"detailed_graphics_card",
  //"detailed_display_monitor",
  //"detailed_bios_and_motherboard",
  //"detailed_user_account",
  //"detailed_network_connection",
  //"detailed_audio_and_power"
],
// Define any color name you want here — no limit.
// Supported formats(3): "#RRGGBB","R,G,B","\u001b[...m"
// "RESET"  -> special value, always resets terminal color
"colors": {
// Bitsmooth Lite: softened/pastel versions of the base palette 
"red":            "#F2726B",
"green":          "#3ECF8E",
"yellow":         "#F2C063",
"blue":           "#60A5FA",
"magenta":        "#C084FC",
"cyan":           "#5EEAD4",
"white":          "#E5E7EB",

// Bright variants: same hues, lifted for emphasis/highlights 
"bright_red":     "#F8A39D",
"bright_green":   "#7EE2B8",
"bright_yellow":  "#F6D68E",
"bright_blue":    "#93C5FD",
"bright_magenta": "#D8B4FE",
"bright_cyan":    "#99F6E4",
"bright_white":   "#F9FAFB",

"reset":          "RESET",

// New terminal-panel colors 
"purple":         "#A78BFA",
"amber":          "#F2C063",
"orange":         "#F2924B",
"muted":          "#7D8491",
"muted_2":        "107, 119, 122",
"fg_dim":         "#C9CDD3"
},
"ascii_color_prefixes": {
  // Colors used by $N placeholders inside BinaryArt.txt.
  // Not limited to $1-$15 — add as many as you want.
  // Each value supports the same 3 formats as "colors" above,
  // PLUS you can reference a name already defined in "colors".
  "$1":  "#F2726B",
  "$2":  "46,207,142",
  "$3":  "cyan",
  "$4":  "\u001b[35m",
  "$5":  "magenta",
  "$6":  "cyan",
  "$7":  "white",
  "$8":  "#F2726B",
  "$9":  "#3ECF8E",
  "$10": "#F2C063",
  "$11": "#60A5FA",
  "$12": "#C084FC",
  "$13": "#5EEAD4",
  "$14": "#E5E7EB",
  "$15": "RESET"
},
// Global emoji control. style: "auto"/"color"/"text", enabled:false hides them
"emoji": {
  // NOTE: "text"/"color" are requests only — some glyphs (e.g. 🧿) have no
  // font fallback and will still render in color. Use "mono" for a guaranteed flat look.
    "enabled": false,
    "style": "color"
},
"art": {
    "Ascii_Art": {
        "enabled": true,
        "padding_up": 0,
        "padding_left": 0,
        "padding_right": 0
    },
    "Image": {
        "enabled": false,
        // Windows paths need DOUBLE backslashes ("\\") because a single
        // backslash is a JSON escape character. Forward slashes ("/")
        // "G:/screenshot/sky.jpg"     -> valid
        // "G:\\screenshot\\sky.jpg"   -> valid
        // "G:\screenshot\sky.jpg"     -> invalid
        "image_path":"G:\\screenshot\\hisky.jpg",
        "image_size_percentage": 47,
        "padding_up": 1,
        "padding_left": 0,
        "padding_right": 1
    }
},


// Config schema — read this once, it applies everywhere below.
//
// It might look big and messy at first glance, but it's actually
// fully predictable. Every sub-module (a field, or a sub-value
// inside a group) is built from exactly two parts:
//
//   1. label
//   2. value
//
// And each of those always follows the same shape:
//
//   label: { prefix, prefix_color, text, color, suffix, suffix_color }
//   value: { prefix, prefix_color, color, suffix, suffix_color }
//
// Some of these keys are left out where they have no use case —
// an omitted key just means empty/no effect, nothing breaks.

"header_settings": {
    "enabled": true,

    "prefix": "~>>",
    "prefix_color": "green",

    "label": {
        "text": " BinaryFetch",
        "color": "red"
    },

    "suffix": "",
    "suffix_color": "muted"
},
"compact_date_and_time": {
    "enabled": true,
    "top_line_spacing": 0,
    "order": ["time", " ", "date", " ", "week", " ", "leap_year"],

    "prefix": "╭📅 ",
    "prefix_color": "red",

    "time": {
        "enabled": true,

        "label": {
            "text": "Time",
            "color": "blue",
            "suffix": ": ",
            "suffix_color": "blue"
        },

        "hour": {
            "enabled": true,
            "value": {
                "prefix": "(",
                "prefix_color": "muted_2",
                "color": "muted_2",
                "suffix": ":",
                "suffix_color": "muted_2"
            }
        },
        "minute": {
            "enabled": true,
            "value": {
                "color": "muted_2",
                "suffix": ":",
                "suffix_color": "muted_2"
            }
        },
        "second": {
            "enabled": true,
            "value": {
                "color": "muted_2",
                "suffix": ")",
                "suffix_color": "muted_2"
            }
        }
    },

    "date": {
        "enabled": true,

        "label": {
            "text": "Date",
            "color": "muted_2",
            "suffix": ": ",
            "suffix_color": "muted_2"
        },

        "day": {
            "enabled": true,
            "value": {
                "prefix": "(",
                "prefix_color": "muted_2",
                "color": "muted_2",
                "suffix": " : ",
                "suffix_color": "muted_2"
            }
        },
        "month_name": {
            "enabled": true,
            "value": {
                "color": "muted_2",
                "suffix": " : ",
                "suffix_color": "muted_2"
            }
        },
        "month_num": {
            "enabled": true,
            "value": {
                "color": "muted_2",
                "suffix": " : ",
                "suffix_color": "muted_2"
            }
        },
        "year": {
            "enabled": true,
            "value": {
                "color": "muted_2",
                "suffix": ")",
                "suffix_color": "muted_2"
            }
        }
    },

    "week": {
        "enabled": true,

        "label": {
            "prefix": "(",
            "prefix_color": "muted_2",
            "text": "Week",
            "color": "muted_2",
            "suffix": ": ",
            "suffix_color": "muted_2"
        },
        "num": {
            "enabled": true,
            "value": {
                "color": "muted_2",
                "suffix": "th)",
                "suffix_color": "muted_2"
                
            }
        },
        "day_name": {
            "enabled": false,
            "value": {
                "color": "muted_2",
                "suffix": ") ",
                "suffix_color": "muted_2"
            }
        }
    },

    "leap_year": {
        "enabled": false,

        "label": {
            "text": "Leap Year",
            "color": "muted_2",
            "suffix": ": ",
            "suffix_color": "muted_2"
        },

        "val": {
            "enabled": true,
            "value": {
                "prefix": "(",
                "prefix_color": "muted_2",
                "color": "muted_2",
                "suffix": ")",
                "suffix_color": "muted_2"
            }
        }
    }
},
"compact_operating_system": {
    "enabled": true,
    "top_line_spacing": 0,
    "order": ["name", " ", "build", " ", "arch", " ", "uptime"],

    "prefix": "│🎯 ",
