            "prefix": "/",
            "prefix_color": "muted_2",
            "color": "muted_2",
            "suffix": "t)",
            "suffix_color": "muted_2"
        }
    },
    "name": {
        "enabled": true,
        "value": {
            "color": "muted_2"
        }
    },
    "clock": {
        "enabled": true,
        "value": {
