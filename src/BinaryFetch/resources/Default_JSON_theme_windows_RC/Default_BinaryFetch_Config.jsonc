"detailed_system_memory": {
  "enabled": true,
  "top_line_spacing": 1,
  "sections": {
    "header": true,
    "total": true,
    "free": true,
    "used_percentage": true,
    "modules": true
  },
  "header": {
    "prefix": "~>> ",
